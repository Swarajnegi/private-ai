jarvis_data/context_store/episodes/
jarvis_data/context_store/manifest.jsonl
jarvis_data/context_store/*.lock
jarvis_data/context_store/**/*.lock
# Episode index (Phase 3): a PROJECTION, rebuilt from episodes/ + the KB by
